# Copy to .env and adjust for local development.
DATABASE_URL=sqlite:///sebxrif.db
# MLflow 3 retired the filesystem backend; use SQLite locally or the
# docker-compose server (http://localhost:5000).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
SEBXRIF_SEED=42

# Learning Record Store (lrsql in docker-compose maps to host :8081).
LRS_ENDPOINT=http://localhost:8081/xapi
LRS_KEY=seb-xrif-lrs
LRS_SECRET=seb-xrif-secret
